{
  "name": "@violentmonkey/url",
  "version": "0.1.1",
  "description": "Add SPA support to your userscript.",
  "license": "MIT",
  "author": "Gerald <gera2ld@live.com>",
  "repository": "git@github.com:violentmonkey/vm-url.git",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && oxlint --fix && oxfmt",
    "dev": "vite build --watch",
    "clean": "rm -rf dist types",
    "build:types": "tsc -p tsconfig.prod.json",
    "build": "npm run check && npm run clean && vite build && npm run build:types",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/dom-navigation": "^1.0.7",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
